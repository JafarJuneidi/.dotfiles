#!/usr/bin/env bash

if [[ -z $STOW_FOLDERS ]]; then
    STOW_FOLDERS="nvim,tmux,zsh,bin,alacritty,agents"
fi


if [[ -z $DOTFILES ]]; then
    DOTFILES=$HOME/.dotfiles
fi


cd "$DOTFILES"
for folder in $(echo $STOW_FOLDERS | sed "s/,/ /g")
do
    echo "stow $folder"
    stow -D $folder
    stow $folder
done

# Mirror ~/.agents/skills -> ~/.claude/skills as symlinks
if [[ -d $HOME/.agents/skills ]]; then
    mkdir -p $HOME/.claude/skills
    shopt -s nullglob
    for d in "$HOME"/.agents/skills/*/; do
        name=$(basename "$d")
        ln -sfn "$HOME/.agents/skills/$name" "$HOME/.claude/skills/$name"
    done
fi
